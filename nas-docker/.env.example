# "physical" sums every physical NIC. Use "auto" or a name to select one NIC.
NAS_STATUS_IFACE=physical
NAS_STATUS_PORT=18199

# Comma-separated fnOS volume roots mounted read-only by compose.yml.
NAS_STATUS_STORAGE_PATHS=/vol1,/vol2
NAS_STATUS_SMART_MAX_AGE_SECONDS=7200

# Generate a strong token, for example: openssl rand -hex 32
NAS_STATUS_TOKEN=replace-with-a-long-random-token

# Optional: first-start GUI administrator password (12+ characters).
# Empty generates data/initial-admin-password.txt; ESP token stays independent.
NAS_STATUS_ADMIN_PASSWORD=
